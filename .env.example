# Copy to .env and fill in. Nothing here is a real value.

# --- Service -----------------------------------------------------------------
# The https address Twilio reaches this service at. A tunnel address works for local runs.
PUBLIC_URL=
PORT=8080
# Signs the short-lived token in the socket URL. Any long random string.
APP_SECRET=

# --- Twilio ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Development only: accept requests without Twilio's signature. Never in production.
# ALLOW_UNSIGNED=1

# --- The model ---------------------------------------------------------------
# A vendor: anthropic, openai, google, deepseek, xai, mistral, groq, openrouter, ollama.
AI_PROVIDER=
# Or, instead, the base URL of any OpenAI-compatible endpoint.
AI_BASE_URL=
# The model id exactly as the vendor lists it. It must support tool calling.
AI_MODEL=
# The key: here, or in the vendor's own variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, …).
AI_API_KEY=
# Optional, US dollars per million tokens, so the cost of a call can be totalled.
AI_PRICE_IN=
AI_PRICE_OUT=

# --- The voice ---------------------------------------------------------------
# The name the assistant answers with. Empty: "I'm the AI assistant here".
PERSONA=
# Your own first sentence. Keep the disclosure that it is an AI assistant.
GREETING=
# ElevenLabs (default; the only one with language switching), Amazon or Google.
TTS_PROVIDER=ElevenLabs
# A voice id Twilio knows for that provider. Empty: Twilio's default English voice.
VOICE=
# Languages the call may switch to, besides English: es-US,pt-BR,fr-FR,de-DE,it-IT
LANGUAGES=
# E.164 number a person answers. Empty: the assistant takes a message instead.
TRANSFER_TO=
MAX_MINUTES=10
MAX_TURNS=40

# --- The business ------------------------------------------------------------
BUSINESS_NAME=
BUSINESS_TIMEZONE=America/New_York
# A sentence the assistant may read out: Monday to Friday, 9 a.m. to 5 p.m.
BUSINESS_HOURS=
# What the business does and what the assistant may state as fact. It never invents the rest.
BUSINESS_KNOWLEDGE=
# What a booked appointment is called when spoken: a discovery call
APPOINTMENT_NAME=
APPOINTMENT_MINUTES=30

# --- The CRM -----------------------------------------------------------------
# memory: a CRM held in the process, for trying the service.
# whitelabel: whitelabel-crm over its connector API.
CRM=memory
CRM_ORIGIN=
CRM_CONNECTOR_API_KEY=
# The booking calendar times are offered from (its id in the CRM).
CRM_CALENDAR_ID=

# --- Storage -----------------------------------------------------------------
# Postgres for live call state. Unset: kept in memory, which is fine for one instance.
DATABASE_URL=
